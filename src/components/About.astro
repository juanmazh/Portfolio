---
import aboutData from '../data/about.json';
---

<section id="sobre-mi" class="section-padding bg-white dark:bg-gray-900 transition-colors duration-300">
	<div class="container-custom">
		<div class="text-center mb-16" data-animate>
			<h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">{aboutData.title}</h2>
			<p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">{aboutData.subtitle}</p>
		</div>

		<div class="grid lg:grid-cols-2 gap-12 items-center">
			<!-- Contenido -->
			<div class="space-y-8" data-animate-left>
				<div class="space-y-6">
					<h3 class="text-2xl font-semibold text-gray-900 dark:text-white">Mi Historia</h3>
					<p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
						{aboutData.description}
					</p>
					<p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
						{aboutData.secondDescription}
					</p>
				</div>

				<!-- Información personal -->
				<div class="space-y-4">
					<h3 class="text-2xl font-semibold text-gray-900 dark:text-white">Información Personal</h3>
					<div class="grid sm:grid-cols-2 gap-4">
						{aboutData.personalInfo.map((info) => (
							<div class="flex justify-between items-center py-2 border-b border-gray-200 dark:border-gray-700">
								<span class="font-bold text-gray-700 dark:text-gray-300">{info.label}:</span>
								<span class="text-gray-900 dark:text-gray-100">{info.value}</span>
							</div>
						))}
					</div>
				</div>

				<!-- Intereses -->
				<div class="space-y-4">
					<h3 class="text-2xl font-semibold text-gray-900 dark:text-white">Intereses</h3>
					<div class="flex flex-wrap gap-3">
						{aboutData.interests.map((interest) => (
							<span class="px-4 py-2 bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-300 rounded-full text-sm font-medium">
								{interest}
							</span>
						))}
					</div>
				</div>
			</div>

			<!-- Imagen/Ilustración -->
			<div class="flex justify-center" data-animate-right>
				<div class="relative">
					<div class="w-96 h-96 bg-gradient-to-br from-green-400 to-blue-500 rounded-2xl flex items-center justify-center shadow-2xl transform rotate-3 overflow-hidden">
						<div class="w-80 h-80 bg-white dark:bg-gray-800 rounded-2xl flex items-center justify-center transform -rotate-3 overflow-hidden">
							<img 
								src="./assets/foto.jpg" 
								alt="Juan Manuel Zafra Hernández" 
								class="w-full h-full object-cover rounded-2xl"
							/>
						</div>
					</div>
					<!-- Elementos decorativos -->
					<div class="absolute -top-6 -right-6 w-12 h-12 bg-yellow-400 rounded-full animate-bounce"></div>
					<div class