---
import skillsData from '../data/skills.json';
---

<section id="habilidades" class="section-padding bg-white dark:bg-gray-900 transition-colors duration-300">
	<div class="container-custom">
		<div class="text-center mb-16" data-animate>
			<h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Habilidades</h2>
			<p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
				Un conjunto diverso de habilidades técnicas y blandas que me permiten crear soluciones completas y efectivas.
			</p>
		</div>

		<div class="grid lg:grid-cols-2 gap-16">
			<!-- Habilidades Técnicas -->
			<div class="space-y-8" data-animate-left>
				<h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Habilidades Técnicas</h3>

				{skillsData.technical.map((category) => (
					<div class="space-y-4">
						<h4 class="text-lg font-medium text-gray-800 dark:text-gray-200">{category.name}</h4>
						<div class="flex flex-wrap gap-2">
							{category.skills.map((skill) => (
								<a
									href={skill.url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-block px-4 py-2 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 font-medium border border-blue-200 dark:border-blue-700 hover:bg-blue-100 dark:hover:bg-blue-900/60 hover:text-blue-900 dark:hover:text-blue-200 transition-colors duration-200 shadow-sm"
								>
									{skill.name}
								</a>
							))}
						</div>
					</div>
				))}
			</div>

			<!-- Habilidades Blandas -->
			<div class="space-y-8" data-animate-right>
				<h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Habilidades Blandas</h3>

				<div class="grid gap-6">
					{skillsData.soft.map((skill, i) => (
						<div class="card p-6 hover:shadow-lg transition-shadow duration-300" data-animate data-delay={i * 100}>
							<h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">{skill.name}</h4>
							<p class="text-gray-600 dark:text-gray-400 leading-relaxed">{skill.description}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</section>
